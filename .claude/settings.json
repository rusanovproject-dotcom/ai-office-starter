{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Read(credentials*)",
      "Read(**/credentials*)",
      "Read(secrets*)",
      "Read(**/secrets*)",
      "Read(config.env)",
      "Read(**/config.env)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(*.pem)",
      "Edit(**/*.pem)",
      "Edit(credentials*)",
      "Edit(**/credentials*)",
      "Edit(secrets*)",
      "Edit(**/secrets*)",
      "Edit(config.env)",
      "Edit(**/config.env)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(telnet:*)",
      "Bash(ssh:*)",
      "Bash(ftp:*)",
      "Bash(mail:*)",
      "Bash(sendmail:*)",
      "Bash(python3 -c:*)",
      "Bash(python -c:*)",
      "Bash(node -e:*)",
      "Bash(perl -e:*)",
      "Bash(ruby -e:*)",
      "Bash(gh gist:*)",
      "Bash(gh api:*)",
      "Bash(gh repo create:*)",
      "Bash(*--dangerously-skip-permissions*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git -c:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git config*hooksPath*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push --force:*)",
      "Bash(git push*--force*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'd=\"$PWD\"; while [ ! -f \"$d/.office-template.json\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; [ -f \"$d/.office-template.json\" ] || { echo \"BLOCKED: office root not found\" >&2; exit 1; }; exec bash \"$d/scripts/office/run.sh\" adapter claude' # office-hook-bundle:52754c66c9c85411df629b96a0b93bcfa7f5b3a3727113c94a7beac30b5959f4",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'd=\"$PWD\"; while [ ! -f \"$d/.office-template.json\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; [ -f \"$d/.office-template.json\" ] || { echo \"BLOCKED: office root not found\" >&2; exit 1; }; exec bash \"$d/scripts/office/run.sh\" adapter claude' # office-hook-bundle:52754c66c9c85411df629b96a0b93bcfa7f5b3a3727113c94a7beac30b5959f4",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
